# ── Base de datos ─────────────────────────────────────────
POSTGRES_DB=laesperanza_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_strong_password

# URL de conexión para Prisma (usa el nombre del servicio Docker como host)
DATABASE_URL=postgresql://admin:change_me_strong_password@db:5432/laesperanza_db

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_random_64_char_secret
JWT_EXPIRES_IN=7d

# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173,http://localhost:8081,https://tudominio.com
